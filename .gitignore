```gitignore
# Python
__pycache__/
*.py[cod]
*$py.class

# Virtual environment
venv/
.venv/
env/
ENV/

# Django
*.log
db.sqlite3
db.sqlite3-journal

# Environment variables / secrets
.env
.env.*
!.env.example

# Static / media
staticfiles/
media/

# IDE / Editor
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Python tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Build / packaging
build/
dist/
*.egg-info/

# Jupyter
.ipynb_checkpoints/

# Celery
celerybeat-schedule
celerybeat.pid
```
